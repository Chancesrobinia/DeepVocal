    {
      "predicate": "beat-count",
      "pattern": "(?P<head>[1-9][0-9]?\\s*[/／]\\s*[1-9][0-9]?)\\s*是单三拍子[，,]\\s*每小节有(?P<tail>三|3)个四分音符拍"
    },
    {
      "predicate": "beat-count",
      "pattern": "(?P<head>[234]\\s*[/／]\\s*4)\\s*每小节(?P<tail>两|二|三|四|[234])拍"
    },
    {
      "predicate": "semitone-count",
      "pattern": "(?P<tail>两个)连续的半音合起来是一个(?P<head>全音)"
    },
